APP_NAME=GlassMate
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/glassmate

# PostgreSQL Configuration (Docker/Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=glassmate
POSTGRES_PORT=5432

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend Environment
NODE_ENV=development

